#!/bin/sh
set -eu

REPO_DIR=${ROBUUST_AGENTS_DIR:-/Users/joostwaaijer/Documents/workspace/robuust-agents}
AGENT_HOME=${AGENT_HOME:-${CODEX_HOME:-"$HOME/.codex"}}

# Preserve the personal repository's physical copies and local Git settings.
if [ -d "$AGENT_HOME/git-instructions" ] && [ ! -L "$AGENT_HOME/git-instructions" ]; then
    printf 'Skipped synchronization: skills and Git instructions are maintained as local copies.\n'
    exit 0
fi

cd "$REPO_DIR"

current_branch=$(git branch --show-current)
if [ "$current_branch" != "main" ]; then
    printf 'Skipped synchronization: checkout is on %s, not main.\n' "${current_branch:-detached HEAD}"
    exit 0
fi

if [ -n "$(git status --porcelain)" ]; then
    printf 'Skipped synchronization: checkout has local changes.\n'
    exit 0
fi

git pull --ff-only origin main

python3 "$REPO_DIR/scripts/sync-git-settings.py" --agent-home "$AGENT_HOME"

mkdir -p "$AGENT_HOME/skills"

for skill_path in "$REPO_DIR"/skills/*; do
    [ -d "$skill_path" ] || continue

    skill_name=${skill_path##*/}

    # Keep intentionally removed shared skills uninstalled.
    case "$skill_name" in
        deferred-validation-development|github-issues|gtm-patterns-craft|\
        infer-craft-conventions|moneybird-servicekaart-invoicing|\
        seo-patterns-craft|tailwind-patterns-twig)
            continue
            ;;
    esac

    local_skill="$AGENT_HOME/skills/$skill_name"

    if [ -L "$local_skill" ]; then
        [ "$(readlink "$local_skill")" = "$skill_path" ] || rm "$local_skill"
    elif [ -e "$local_skill" ]; then
        echo "Skipping $skill_name: $local_skill is not a symlink" >&2
        continue
    fi

    [ -L "$local_skill" ] || ln -s "$skill_path" "$local_skill"
done

for local_skill in "$AGENT_HOME"/skills/*; do
    [ -L "$local_skill" ] || continue

    skill_path=$(readlink "$local_skill")
    case "$skill_path" in
        "$REPO_DIR"/skills/*)
            [ -e "$skill_path" ] || rm "$local_skill"
            ;;
    esac
done
