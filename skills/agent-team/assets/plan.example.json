{
  "schema": "agent-team-plan/1",
  "objective": "EXAMPLE: expose one agreed backend contract and render it in the frontend",
  "independent_review": true,
  "limits": {
    "max_parallel": 6,
    "delegation_depth": 1,
    "max_retries": 1,
    "max_rework_cycles": 2
  },
  "repositories": [
    {"id": "backend", "root": "/path/to/backend", "branch": "feature/example", "base": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "local_changes": "EXAMPLE: clean at inspection"},
    {"id": "frontend", "root": "/path/to/frontend", "branch": "feature/example", "base": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "local_changes": "EXAMPLE: clean at inspection"}
  ],
  "authorization": {
    "read": [
      {"package": "contract", "repository": "backend", "reference": "EXAMPLE: backend contract investigation"},
      {"package": "backend-code", "repository": "backend", "reference": "EXAMPLE: backend task"},
      {"package": "frontend-code", "repository": "frontend", "reference": "EXAMPLE: frontend task"},
      {"package": "integrated-review", "repository": "backend", "reference": "EXAMPLE: integrated review of backend and frontend"},
      {"package": "integrated-review", "repository": "frontend", "reference": "EXAMPLE: integrated review of backend and frontend"}
    ],
    "edit": [
      {"package": "backend-code", "repository": "backend", "reference": "EXAMPLE: user task authorizing backend edits"},
      {"package": "frontend-code", "repository": "frontend", "reference": "EXAMPLE: user task authorizing frontend edits"}
    ],
    "run_tests": [
      {"package": "backend-code", "repository": "backend", "test_family": "public-view API suite", "reference": "EXAMPLE: user's explicit request to run this suite"}
    ],
    "message_chat": [
      {"package": "integrated-review", "repository": "backend", "destination": "example-coordinator-chat", "reference": "EXAMPLE: user's authorization to report to this chat"}
    ]
  },
  "contracts_existing": [],
  "packages": [
    {
      "id": "contract", "owner": "lead", "kind": "decide", "repository": "backend",
      "writes": [], "depends_on": [], "produces": ["public-view"], "consumes": [],
      "actions": ["read"], "criteria": ["AC-CONTRACT"], "skills": ["codebase-design"]
    },
    {
      "id": "backend-code", "owner": "backend-worker", "kind": "implement", "repository": "backend",
      "writes": ["src/public-view/"], "depends_on": ["contract"], "produces": [], "consumes": ["public-view"],
      "actions": ["read", "edit", {"action": "run_tests", "test_family": "public-view API suite"}],
      "criteria": ["AC-BACKEND"], "skills": ["project-backend-skill"]
    },
    {
      "id": "frontend-code", "owner": "frontend-worker", "kind": "implement", "repository": "frontend",
      "writes": ["src/public-view/"], "depends_on": ["contract"], "produces": [], "consumes": ["public-view"],
      "actions": ["read", "edit"], "criteria": ["AC-FRONTEND"], "skills": ["project-frontend-skill"]
    },
    {
      "id": "integrated-review", "owner": "independent-reviewer", "kind": "review", "repository": "backend",
      "writes": [], "depends_on": ["backend-code", "frontend-code"], "produces": [], "consumes": ["public-view"],
      "reviews": ["backend-code", "frontend-code"],
      "actions": ["read", {"action": "message_chat", "destination": "example-coordinator-chat"}],
      "criteria": ["AC-INTEGRATED-REVIEW"], "skills": ["code-review"]
    }
  ]
}
