# Track only explicitly selected configuration and user-managed files.
# New runtime files stay excluded until deliberately allowed here.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/config.toml
!/agents/
/agents/*
!/agents/researcher.toml
!/agents/planner.toml
!/agents/implementer.toml
!/agents/reviewer.toml
!/agents/functional-analyst.toml
!/agents/domain-modeler.toml
!/agents/delivery-specialist.toml
!/agents/regression-reviewer.toml
!/agents/references/
!/agents/references/**
!/agents/templates/
/agents/templates/*
!/agents/templates/org/
/agents/templates/org/*
!/agents/templates/org/AGENTS.md
!/git-instructions
!/git-instructions/**
!/references/
/references/*
!/references/robuust-agents/
!/references/robuust-agents/**
!/bin/
!/bin/**
!/rules/
!/rules/**
!/skills/
!/skills/**
!/automations/
/automations/*
!/automations/*/
/automations/*/*
!/automations/*/automation.toml

# Bundled system skills, old backups, generated files, and credentials.
/skills/.*
.DS_Store
__pycache__/
node_modules/
*.pyc
*.bak
*.tmp
*.log
*.sqlite*
*.db
.env
.env.*
*.pem
*.key
.credentials*
auth.json*
